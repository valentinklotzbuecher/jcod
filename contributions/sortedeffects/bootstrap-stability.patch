diff --git a/tests/binomial-bootstrap.R b/tests/binomial-bootstrap.R
new file mode 100644
index 0000000..48b140e
--- /dev/null
+++ b/tests/binomial-bootstrap.R
@@ -0,0 +1,105 @@
+# Weighted binomial fits must be independent of the arbitrary CA weight scale.
+# No additional test dependencies or external datasets are required.
+library(SortedEffects)
+peestimate <- getFromNamespace("peestimate", "SortedEffects")
+
+set.seed(2)
+n <- 120L
+dat <- data.frame(treatment = rep(0:1, n/2), x = rnorm(n),
+                  female = rep(rep(0:1, each = 2), n/4))
+dat$outcome <- rbinom(n, 1, plogis(-.6 + .8*dat$x + .4*dat$female +
+                                   .8*dat$treatment - .8*dat$treatment*dat$female))
+dat$x2 <- dat$x^2
+fm <- outcome ~ treatment*(x+female) + I(x^2)
+counts <- tabulate(sample.int(n, n, replace = TRUE), nbins = n)
+weights <- counts/sum(counts)*20000
+subgroup <- dat$female == 1
+
+for (link in c("logit", "probit")) {
+  reference <- suppressWarnings(peestimate(fm, dat, counts, "binary",
+    "treatment", NULL, link, subgroup))
+  scaled <- suppressWarnings(peestimate(fm, dat, weights, "binary",
+    "treatment", NULL, link, subgroup))
+  stopifnot(isTRUE(all.equal(reference$pe_est, scaled$pe_est, tolerance = 1e-6)),
+            isTRUE(all.equal(reference$pesub_est, scaled$pesub_est, tolerance = 1e-6)),
+            identical(scaled$samp_weight_sub, weights[subgroup]))
+
+  # A factor response denotes the same Bernoulli likelihood.
+  factor_dat <- dat
+  factor_dat$outcome <- factor(factor_dat$outcome, levels = 0:1)
+  factor_result <- suppressWarnings(peestimate(fm, factor_dat, weights,
+    "binary", "treatment", NULL, link, subgroup))
+  stopifnot(isTRUE(all.equal(factor_result$pe_est, scaled$pe_est,
+                            tolerance = 1e-6)))
+
+  # glm's data mask must not replace the supplied fitting weights with an
+  # unrelated column whose name happens to match an internal variable.
+  shadow_dat <- dat
+  shadow_dat$fit_weight <- seq_len(n)
+  shadow_dat$samp_weight <- rev(seq_len(n))
+  shadow_result <- suppressWarnings(peestimate(fm, shadow_dat, weights,
+    "binary", "treatment", NULL, link, subgroup))
+  stopifnot(isTRUE(all.equal(shadow_result$pe_est, scaled$pe_est,
+                            tolerance = 1e-6)))
+}
+
+# Scaling prior weights also preserves the grouped-binomial likelihood.
+grouped <- expand.grid(treatment = 0:1, female = 0:1, x = c(-1, 0, 1))
+grouped$trials <- 25 + 3*seq_len(nrow(grouped))
+probability <- plogis(-.6 + .8*grouped$x + .4*grouped$female +
+                       .8*grouped$treatment - .8*grouped$treatment*grouped$female)
+grouped$success <- round(grouped$trials*probability)
+grouped$failure <- grouped$trials - grouped$success
+grouped_weights <- rep(c(1, 2, 3), length.out = nrow(grouped))
+grouped_fm <- cbind(success, failure) ~ treatment*(x+female) + I(x^2)
+for (link in c("logit", "probit")) {
+  reference <- peestimate(grouped_fm, grouped, grouped_weights, "binary",
+    "treatment", NULL, link)
+  scaled <- peestimate(grouped_fm, grouped, grouped_weights*1000, "binary",
+    "treatment", NULL, link)
+  stopifnot(isTRUE(all.equal(reference$pe_est, scaled$pe_est, tolerance = 1e-6)))
+}
+
+# Reconstruct public ca() results from glm, original 20,000-total quantile
+# weights, tail means, and the documented centered bootstrap statistics.
+# This also checks that fitting normalization does not alter quantile weights.
+traits <- c("x", "female", "x2")
+B <- 39L
+for (link in c("logit", "probit")) {
+  moments <- function(fit_weights, quantile_weights) {
+    fit_dat <- dat
+    fit_dat$w <- fit_weights
+    fit <- suppressWarnings(glm(fm, fit_dat, family = binomial(link), weights = w))
+    stopifnot(fit$converged, fit$rank == 7L)
+    control <- treated <- dat
+    control$treatment <- 0
+    treated$treatment <- 1
+    effects <- predict(fit, treated, type = "response") -
+      predict(fit, control, type = "response")
+    cutoffs <- Hmisc::wtd.quantile(effects, quantile_weights, c(.1, .9))
+    low <- effects <= cutoffs[1]
+    high <- effects >= cutoffs[2]
+    vapply(traits, function(trait) {
+      weighted.mean(dat[[trait]][high], quantile_weights[high]) -
+        weighted.mean(dat[[trait]][low], quantile_weights[low])
+    }, numeric(1))
+  }
+  point <- moments(rep(1, n), rep(1, n))
+  set.seed(420)
+  draws <- t(replicate(B, {
+    counts <- tabulate(sample.int(n, n, replace = TRUE), nbins = n)
+    quantile_weights <- counts/sum(counts)*20000
+    moments(quantile_weights/mean(quantile_weights), quantile_weights)
+  }))
+  centered <- sweep(draws, 2, point)
+  standard_errors <- apply(centered, 2, IQR)/diff(qnorm(c(.25, .75)))
+  stopifnot(all(is.finite(draws)), all(standard_errors > 0))
+  maxima <- apply(abs(sweep(centered, 2, standard_errors, "/")), 1, max)
+  joint <- vapply(abs(point/standard_errors), function(z) mean(maxima > z), numeric(1))
+  result <- suppressWarnings(SortedEffects::ca(fm, dat, method = link,
+    var = "treatment", var_type = "binary", interest = "moment", cl = "diff",
+    t = traits, b = B, seed = 420, bc = FALSE))
+  stopifnot(isTRUE(all.equal(as.numeric(result$est), unname(point), tolerance = 1e-7)),
+            isTRUE(all.equal(unname(result$bse), unname(standard_errors), tolerance = 1e-7)),
+            isTRUE(all.equal(unname(result$joint_p), unname(joint), tolerance = 1e-7)))
+}
diff --git a/tests/invalid-inference.R b/tests/invalid-inference.R
new file mode 100644
index 0000000..e8edfb6
--- /dev/null
+++ b/tests/invalid-inference.R
@@ -0,0 +1,65 @@
+library(SortedEffects)
+
+expect_error <- function(expr, pattern) {
+  error <- tryCatch({ force(expr); NULL }, error = identity)
+  stopifnot(inherits(error, "error"),
+            grepl(pattern, conditionMessage(error), fixed = TRUE))
+}
+
+# Separation can still prevent convergence after weight normalization. Public
+# functions suppress glm warnings, so this must be an error rather than a warning.
+separated <- data.frame(treatment = rep(0:1, 60),
+                        x = seq(-1, 1, length.out = 120))
+separated$outcome <- as.integer(separated$x > 0)
+expect_error(spe(outcome ~ treatment + x, data = separated,
+                 method = "logit", var_type = "binary", var = "treatment",
+                 us = c(.1, .5, .9), b = 9),
+             "The binomial GLM did not converge")
+
+set.seed(2)
+n <- 120
+d <- data.frame(treatment = rep(0:1, n / 2), x = rnorm(n),
+                female = rep(rep(0:1, each = 2), n / 4))
+d$outcome <- rbinom(n, 1, plogis(-.6 + .8 * d$x + .4 * d$female +
+                                .8 * d$treatment - .8 * d$treatment * d$female))
+d$constant <- 1
+d$missing_characteristic <- NA_real_
+fm <- outcome ~ treatment * (x + female) + I(x^2)
+args <- list(fm = fm, data = d, method = "logit", var_type = "binary",
+             var = "treatment", interest = "moment", cl = "diff",
+             t = c("x", "female"), b = 39, seed = 420, bc = FALSE)
+
+# Distribution estimates are stored as a list before inference; the shared
+# finite-value check must accept that representation as well as moment matrices.
+dist_args <- args
+dist_args$interest <- "dist"
+dist_args$t <- "x"
+dist_args$range_cb <- c(.2, .4, .6, .8)
+distribution <- do.call(ca, dist_args)
+stopifnot(all(is.finite(unlist(distribution$infresults))))
+
+missing_args <- args
+missing_args$t <- c("x", "missing_characteristic")
+expect_error(do.call(ca, missing_args),
+             "Classification estimates contain non-finite values")
+
+constant_args <- args
+constant_args$t <- c("x", "constant")
+expect_error(do.call(ca, constant_args),
+             "Classification bootstrap standard errors must be finite and positive")
+
+# Exercise failure handling after boot returns. Cloning the closure leaves the
+# installed namespace untouched. Test both an entirely invalid draw (which used
+# to become -Inf in the maximum) and a draw missing only one characteristic.
+for (invalid in list(c(NA_real_, NaN), c(0, Inf))) {
+  checked_ca <- ca
+  test_env <- new.env(parent = environment(ca))
+  test_env$boot <- function(...) {
+    result <- boot::boot(...)
+    result$t[1, ] <- invalid
+    result
+  }
+  environment(checked_ca) <- test_env
+  expect_error(do.call(checked_ca, args),
+               "non-finite statistics in 1 of 39 draws")
+}
